# 環境変数テンプレート (.env.hybrid.example)
# 実際の値は .env.hybrid に設定してください (Git管理外)

# --- Postgres ---
DB_POSTGRES_USER=n8n
DB_POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_POSTGRES_DATABASE=n8n

# --- n8n settings ---
N8N_HOST=n8n
WEBHOOK_URL=https://n8n.yourdomain.com/
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# 暗号キー（必須。32+ バイトのランダム文字列）
# 生成例: openssl rand -base64 32
N8N_ENCRYPTION_KEY=CHANGE_ME_RANDOM_32PLUS_CHARS_STRING

# --- Ghost integration ---
GHOST_BASE_URL=https://ghost.100.67.3.125.sslip.io
GHOST_CONTENT_API_URL=https://ghost.100.67.3.125.sslip.io/ghost/api/content
GHOST_ADMIN_API_URL=https://ghost.100.67.3.125.sslip.io/ghost/api/admin
GHOST_CONTENT_API_KEY=CHANGE_ME_GHOST_CONTENT_KEY
GHOST_ADMIN_API_KEY=CHANGE_ME_GHOST_ADMIN_KEY

# --- Let's Encrypt / NPM ---
LETSENCRYPT_EMAIL=your-email@example.com
